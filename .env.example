# Firebase Configuration (Public - safe for client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Server-side only - NEVER commit real values)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Cloudinary (Server-side only for upload, public config is fine)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://merantireport.com

# GitHub Token (only used during repository setup, not needed at runtime)
GITHUB_TOKEN=
